# ---------------------------------------------------------------------------
# filestore-s3 — Google Cloud Storage interoperability test configuration
#
# Copy to  filestore-s3/.env  and fill in real values.
# The real .env is git-ignored and MUST NEVER be committed.
#
# Real environment variables take precedence over entries in this file, so CI
# can inject the secrets without a file being present.
#
# Provisioning instructions: see docs/gcs/setup.md
# ---------------------------------------------------------------------------

# Master switch. When not exactly "true", every GCS test is skipped.
GCS_TEST_ENABLED=false

# Bucket must already exist — the test does not create it (GCS bucket creation
# over the XML API needs an x-goog-project-id header the client does not send).
GCS_BUCKET_NAME=osgi-filestore-s3-test

# S3 interoperability endpoint. Trailing slash optional.
GCS_ENDPOINT=https://storage.googleapis.com

# HMAC key of a service account holding roles/storage.objectAdmin on the bucket.
# Cloud Console: Cloud Storage -> Settings -> Interoperability.
# Access ID always starts with GOOG.
GCS_ACCESS_KEY=GOOG1EXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GCS_SECRET_KEY=

# Only used for the SigV4 credential scope; GCS does not validate it against
# the bucket location. Leave as-is unless you know otherwise.
GCS_REGION=us-east-1

# URL stream handler protocol registered by the component.
GCS_PROTOCOL=gcsstore
